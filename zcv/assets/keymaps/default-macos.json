[
  {
    "context": "Editor",
    "bindings": {
      "alt-left": "editor::MoveToPreviousWord",
      "alt-right": "editor::MoveToNextWord",
      "alt-shift-left": "editor::SelectToPreviousWord",
      "alt-shift-right": "editor::SelectToNextWord",
      "backspace": "editor::Backspace",
      "alt-backspace": "editor::DeleteToPreviousWordStart",
      "alt-delete": "editor::DeleteToNextWordEnd",
      "cmd-backspace": "editor::DeleteToBeginningOfLine",
      "cmd-delete": "editor::DeleteToEndOfLine",
      "cmd-a": "editor::SelectAll",
      "cmd-c": "editor::Copy",
      "cmd-up": "editor::MoveToBeginning",
      "cmd-down": "editor::MoveToEnd",
      "cmd-shift-up": "editor::SelectToBeginning",
      "cmd-shift-down": "editor::SelectToEnd",
      "home": "editor::MoveToBeginningOfLine",
      "end": "editor::MoveToEndOfLine",
      "cmd-shift-left": "editor::SelectToBeginningOfLine",
      "cmd-shift-right": "editor::SelectToEndOfLine",
      "cmd-shift-z": "editor::Redo",
      "cmd-v": "editor::Paste",
      "cmd-x": "editor::Cut",
      "cmd-z": "editor::Undo",
      "delete": "editor::Delete",
      "down": "editor::MoveDown",
      "pageup": "editor::MovePageUp",
      "pagedown": "editor::MovePageDown",
      "shift-pageup": "editor::SelectPageUp",
      "shift-pagedown": "editor::SelectPageDown",
      "enter": "editor::Newline",
      "left": "editor::MoveLeft",
      "right": "editor::MoveRight",
      "up": "editor::MoveUp",
      "shift-down": "editor::SelectDown",
      "shift-left": "editor::SelectLeft",
      "shift-right": "editor::SelectRight",
      "shift-up": "editor::SelectUp",
      "tab": "editor::Indent",
      "shift-tab": "editor::Outdent"
    }
  },
  {
    "context": "ProjectTree",
    "bindings": {
      "down": "project_tree::TreeSelectNext",
      "left": "project_tree::TreeCollapse",
      "right": "project_tree::TreeExpand",
      "space": "project_tree::TreeActivate",
      "up": "project_tree::TreeSelectPrev"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "up": "picker::PickerSelectPrev",
      "down": "picker::PickerSelectNext",
      "enter": "picker::PickerConfirm",
      "escape": "picker::PickerCancel",
      "cmd-o": "project_picker::OpenLocalProject"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-h": "pane::PrevTab",
      "cmd-l": "pane::NextTab",
      "cmd-w": "pane::CloseTab"
    }
  },
  {
    "bindings": {
      "cmd-q": "window_controls::QuitWindow",
      "cmd-m": "window_controls::MinimizeWindow",
      "ctrl-cmd-f": "window_controls::ToggleMaximizeWindow",
      "cmd-shift-p": "project_picker::ToggleProjectPicker",
      "cmd-,": "top_bar::OpenSettings",
      "cmd-shift-e": "dock::ToggleProjectTree",
      "cmd-shift-g": "dock::ToggleVersionControl",
      "cmd-shift-o": "dock::ToggleOutline",
      "cmd-shift-l": "dock::ToggleLanguageServer",
      "cmd-shift-m": "dock::ToggleDiagnostics",
      "cmd-shift-f": "dock::ToggleProjectSearch",
      "cmd-`": "dock::ToggleTerminal",
      "cmd-shift-d": "dock::ToggleDebug",
      "cmd-shift-k": "dock::ToggleKeyboardShortcuts",
      "cmd-s": "workspace::Save"
    }
  }
]
