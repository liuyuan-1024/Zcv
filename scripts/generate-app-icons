#!/usr/bin/env bash
# 从唯一的 SVG 原稿生成 macOS 和 Windows 应用图标。

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SOURCE="$ROOT/assets/branding/zcv-app-icon.svg"
MAC_ICON="$ROOT/assets/branding/Zcv.icns"
WINDOWS_ICON="$ROOT/assets/branding/Zcv.ico"

for tool in rsvg-convert iconutil python3; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "缺少图标生成工具: $tool" >&2
        exit 1
    fi
done

if [[ ! -f "$SOURCE" ]]; then
    echo "图标原稿不存在: $SOURCE" >&2
    exit 1
fi

TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/zcv-app-icons.XXXXXX")"
trap 'rm -rf "$TEMP_DIR"' EXIT
ICONSET="$TEMP_DIR/Zcv.iconset"
mkdir -p "$ICONSET"

for size in 16 24 32 48 64 128 256 512 1024; do
    rsvg-convert --format png --width "$size" --height "$size" \
        --output "$TEMP_DIR/icon_${size}.png" "$SOURCE"
done

cp "$TEMP_DIR/icon_16.png" "$ICONSET/icon_16x16.png"
cp "$TEMP_DIR/icon_32.png" "$ICONSET/icon_16x16@2x.png"
cp "$TEMP_DIR/icon_32.png" "$ICONSET/icon_32x32.png"
cp "$TEMP_DIR/icon_64.png" "$ICONSET/icon_32x32@2x.png"
cp "$TEMP_DIR/icon_128.png" "$ICONSET/icon_128x128.png"
cp "$TEMP_DIR/icon_256.png" "$ICONSET/icon_128x128@2x.png"
cp "$TEMP_DIR/icon_256.png" "$ICONSET/icon_256x256.png"
cp "$TEMP_DIR/icon_512.png" "$ICONSET/icon_256x256@2x.png"
cp "$TEMP_DIR/icon_512.png" "$ICONSET/icon_512x512.png"
cp "$TEMP_DIR/icon_1024.png" "$ICONSET/icon_512x512@2x.png"

iconutil --convert icns --output "$MAC_ICON" "$ICONSET"

python3 - "$TEMP_DIR" "$WINDOWS_ICON" <<'PY'
from pathlib import Path
import struct
import sys

source_dir = Path(sys.argv[1])
output = Path(sys.argv[2])
sizes = (16, 24, 32, 48, 64, 128, 256)
images = [(size, (source_dir / f"icon_{size}.png").read_bytes()) for size in sizes]

header = struct.pack("<HHH", 0, 1, len(images))
offset = len(header) + 16 * len(images)
entries = bytearray()
for size, data in images:
    encoded_size = 0 if size == 256 else size
    entries += struct.pack("<BBBBHHII", encoded_size, encoded_size, 0, 0, 1, 32, len(data), offset)
    offset += len(data)

output.write_bytes(header + entries + b"".join(data for _, data in images))
PY

echo "已生成 $MAC_ICON"
echo "已生成 $WINDOWS_ICON"
