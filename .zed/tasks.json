[
  {
      "label": "1. 检查代码",
      "command": "cargo",
      "args": ["clippy"],
      "cwd": "$ZED_WORKTREE_ROOT",
      "save": "all",
      "reveal": "always",
      "hide": "never",
  },
  {
    "label": "2. 格式化代码",
    "command": "cargo",
    "args": ["fmt"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "3. 全量测试",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "4. macOS 调试",
    "command": "cargo",
    "args": ["run", "-p", "Zcv", "--", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "5. macOS 打包",
    "command": "scripts/bundle-mac",
    "args": [],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
]
