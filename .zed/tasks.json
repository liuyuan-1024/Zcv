[
  {
    "label": "1. 检查代码",
    "command": "cargo",
    "args": ["clippy"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "2. 格式化代码",
    "command": "cargo",
    "args": ["fmt"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "3. 全量测试",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "4. macOS Debug 启动软件",
    "command": "zsh",
    "args": ["-i", "-c", "cargo run --bin Zom"],
    "env": {
      "ZOM_DEBUG_PROJECT": "/Users/liuyuan/project/liuyuan/zom",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "4. Windows Debug 启动软件",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "cargo run --bin Zom",
    ],
    "env": {
      "ZOM_DEBUG_PROJECT": "D:/project/liuyuan/zom",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "5. macOS 16MB Rust 性能 + 峰值内存",
    "command": "zsh",
    "args": [
      "-i",
      "-c",
      "cd $ZED_WORKTREE_ROOT && cargo build --release -p zom-bench && /usr/bin/time -l ./target/release/zom-bench run rust 16",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "5. Windows 16MB Rust 性能 + 峰值内存",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "cargo build --release -p zom-bench; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $elapsed = Measure-Command { .\\target\\release\\zom-bench.exe run rust 16 }; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Write-Host ('Elapsed: {0:N3}s' -f $elapsed.TotalSeconds)",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "6. macOS 跨规模 Rust 性能 + 峰值内存",
    "command": "zsh",
    "args": [
      "-i",
      "-c",
      "cd $ZED_WORKTREE_ROOT && cargo build --release -p zom-bench && /usr/bin/time -l ./target/release/zom-bench run rust",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "6. Windows 跨规模 Rust 性能 + 峰值内存",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "cargo build --release -p zom-bench; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $elapsed = Measure-Command { .\\target\\release\\zom-bench.exe run rust }; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Write-Host ('Elapsed: {0:N3}s' -f $elapsed.TotalSeconds)",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "7. macOS 打包 .app",
    "command": "script/bundle-mac",
    "args": ["--no-dmg"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "7. Windows 打包 .exe",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      ".\\script\\bundle-windows.ps1",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "8. 增量更新 codegraph 索引",
    "command": "codegraph",
    "args": ["sync"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "9. 全量更新 codegraph 索引",
    "command": "codegraph",
    "args": ["index"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
]
