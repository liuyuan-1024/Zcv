```gitignore
# ============================================================
# 通用 .gitignore
# 适用于 Rust / Python / Node.js 等常见项目
# ============================================================

# ============================================================
# Rust
# ============================================================

# Cargo 编译产物（依赖缓存、增量编译、最终二进制）
/target/
**/target/

# Cargo.lock：
# - Binary / CLI / Workspace：建议提交（删除下面这一行注释）
# - Library：建议忽略（保留下面这一行）
# Cargo.lock

# rustfmt / cargo fix 生成的备份文件
**/*.rs.bk

# Windows MSVC 调试符号
*.pdb

# ============================================================
# Python
# ============================================================

# 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/
ENV/

# Python 构建产物
build/
dist/
*.egg-info/
.eggs/

# 测试、类型检查、格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 覆盖率
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# ============================================================
# Node.js
# ============================================================

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# 编辑器
# ============================================================

# VS Code
.vscode/*
# 如需共享工作区配置，可取消下面几行注释
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.code-workspace

# JetBrains（IntelliJ IDEA / PyCharm / RustRover 等）
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# ============================================================
# 操作系统缓存
# ============================================================

# macOS
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Desktop.ini

# Linux
.nfs*

# ============================================================
# 日志与临时文件
# ============================================================

*.log
logs/

tmp/
temp/

*.tmp
*.bak
*.orig

# ============================================================
# 环境变量
# ============================================================

.env
.env.*
!.env.example

# ============================================================
# AI 工具
# ============================================================

.claude/
.codex/
.cursor/
.deepseek/
.codegraph/
.qoder/

# ============================================================
# 本地配置
# ============================================================

*.local
*.local.*
```
