#!/usr/bin/env bash
#
# 打包 macOS .app（可选 .dmg）并生成 GitHub Release 风格 zip。
# Release 资产命名: Zcv_xx.xx.xx_darwin_arm64.zip
#
# 用法:
#   scripts/bundle-mac                 # 输出 .app、zip 和 .dmg
#   scripts/bundle-mac --no-dmg        # 输出 .app 和 zip
#   scripts/bundle-mac --app-only      # 只输出 .app（本地调试用）
#
# 仅支持 Apple Silicon（arm64）。

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

APP_NAME="Zcv"
BUNDLE_ID="dev.liuyuan.zcv"
BIN_NAME="Zcv"
PACKAGE="Zcv"
HELPER_PACKAGE="zcv-update"
HELPER_BIN_NAME="zcv-update-helper"
VERSION="$(grep '^version' Cargo.toml | head -n1 | cut -d'"' -f2)"

MAKE_DMG=1
APP_ONLY=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-dmg)
            MAKE_DMG=0; shift ;;
        --app-only)
            APP_ONLY=1; MAKE_DMG=0; shift ;;
        -h|--help)
            sed -n '2,11p' "$0"; exit 0 ;;
        *)
            echo "未知参数: $1" >&2; exit 1 ;;
    esac
done

TARGET="aarch64-apple-darwin"

OS="darwin"
ARCH="arm64"
DIST_NAME="${APP_NAME}_${VERSION}_${OS}_${ARCH}"

if ! xcrun metal -v >/dev/null 2>&1; then
    echo "缺少 Xcode Metal Toolchain（GPUI 编译着色器需要）" >&2
    echo "    xcodebuild -downloadComponent MetalToolchain" >&2
    exit 1
fi

if [[ "$ARCH" == "arm64" && "$(uname -m)" != "arm64" ]]; then
    echo "正在为 arm64 构建，但当前机器是 $(uname -m)。请确认已安装交叉编译环境。" >&2
fi

# ---------- 1. 构建 ----------
echo "==> cargo build --release -p $PACKAGE --target $TARGET"
cargo build --release -p "$PACKAGE" --target "$TARGET"
echo "==> cargo build --release -p $HELPER_PACKAGE --bin $HELPER_BIN_NAME --target $TARGET"
cargo build --release -p "$HELPER_PACKAGE" --bin "$HELPER_BIN_NAME" --target "$TARGET"
BIN="target/$TARGET/release/$BIN_NAME"
HELPER_BIN="target/$TARGET/release/$HELPER_BIN_NAME"
OUT_DIR="target/$TARGET/release"

for REQUIRED_BIN in "$BIN" "$HELPER_BIN"; do
    if [[ ! -f "$REQUIRED_BIN" ]]; then
        echo "构建产物不存在: $REQUIRED_BIN" >&2; exit 1
    fi
done

# ---------- 2. 组装 .app ----------
APP="$OUT_DIR/$APP_NAME.app"
echo "==> 组装 $APP"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Helpers"

cp "$BIN" "$APP/Contents/MacOS/$BIN_NAME"
cp "$HELPER_BIN" "$APP/Contents/Helpers/$HELPER_BIN_NAME"
chmod +x "$APP/Contents/MacOS/$BIN_NAME"
chmod +x "$APP/Contents/Helpers/$HELPER_BIN_NAME"

# ---------- 3. Info.plist ----------
cat > "$APP/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key>
  <string>$APP_NAME</string>

  <key>CFBundleDisplayName</key>
  <string>$APP_NAME</string>

  <key>CFBundleIdentifier</key>
  <string>$BUNDLE_ID</string>

  <key>CFBundleVersion</key>
  <string>$VERSION</string>

  <key>CFBundleShortVersionString</key>
  <string>$VERSION</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleExecutable</key>
  <string>$BIN_NAME</string>

  <key>CFBundleSupportedPlatforms</key>
  <array>
    <string>MacOSX</string>
  </array>

  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>

  <key>NSHighResolutionCapable</key>
  <true/>

  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
</dict></plist>
EOF

# ---------- 4. 代码签名（零费用 ad-hoc） ----------
# 没有 Developer ID 与公证；签名只提供本地完整性校验。
echo "==> codesign (ad-hoc + hardened runtime)"
codesign --force --options runtime --sign - "$APP/Contents/Helpers/$HELPER_BIN_NAME"
codesign --force --options runtime --sign - "$APP/Contents/MacOS/$BIN_NAME"
codesign --force --options runtime --sign - "$APP"

codesign --verify --strict "$APP"

if [[ "$APP_ONLY" == "1" ]]; then
    echo
    echo "完成:"
    echo "  $APP"
    exit 0
fi

# ---------- 5. GitHub Release zip ----------
ZIP="$OUT_DIR/$DIST_NAME.zip"
echo "==> $ZIP"
rm -f "$ZIP"

# --keepParent 让 zip 解压后包含 Zcv.app 这个顶层目录；比 zip -r 更适合 .app bundle。
ditto -c -k --sequesterRsrc --keepParent "$APP" "$ZIP"

# ---------- 6. DMG ----------
if [[ "$MAKE_DMG" == "1" ]]; then
    DMG="$OUT_DIR/$DIST_NAME.dmg"
    echo "==> $DMG"
    rm -f "$DMG"
    hdiutil create -volname "$APP_NAME" -srcfolder "$APP" \
        -ov -format UDZO "$DMG" >/dev/null
fi

echo
echo "完成:"
echo "  $APP"
echo "  $ZIP"
[[ "$MAKE_DMG" == "1" ]] && echo "  $OUT_DIR/$DIST_NAME.dmg"
echo
echo "ad-hoc 包：首次安装需在“系统设置 → 隐私与安全性”中点击“仍要打开”。"
