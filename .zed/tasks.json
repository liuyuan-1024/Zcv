[
  {
    "label": "格式化代码",
    "command": "cargo",
    "args": ["fmt"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "macOS 全量测试",
    "command": "sh",
    "args": ["-c", "cargo fmt && cargo test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "macOS 启动软件",
    "command": "sh",
    "args": ["-c", "cargo fmt && cargo run --bin zom"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "macOS 跨规模 Rust 性能 + 峰值内存",
    "command": "sh",
    "args": [
      "-c",
      "cargo build --release -p zom-bench && /usr/bin/time -l ./target/release/zom-bench run rust",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "macOS 16MB Rust 性能 + 峰值内存",
    "command": "sh",
    "args": [
      "-c",
      "cargo build --release -p zom-bench && /usr/bin/time -l ./target/release/zom-bench run rust 16",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "macOS 打包 .app",
    "command": "script/bundle-mac",
    "args": ["--no-dmg"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },

  {
    "label": "Windows 全量测试",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "cargo fmt; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cargo test",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "Windows 启动软件",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "cargo fmt; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; cargo run --bin zom",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "Windows 跨规模 Rust 性能 + 峰值内存",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "cargo build --release -p zom-bench; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $elapsed = Measure-Command { .\\target\\release\\zom-bench.exe run rust }; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Write-Host ('Elapsed: {0:N3}s' -f $elapsed.TotalSeconds)",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "Windows 16MB Rust 性能 + 峰值内存",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "cargo build --release -p zom-bench; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $elapsed = Measure-Command { .\\target\\release\\zom-bench.exe run rust 16 }; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Write-Host ('Elapsed: {0:N3}s' -f $elapsed.TotalSeconds)",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "Windows 打包 .exe",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      ".\\script\\bundle-windows.ps1",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },

  {
    "label": "增量更新 codegraph 索引",
    "command": "codegraph",
    "args": ["sync"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "全量更新 codegraph 索引",
    "command": "codegraph",
    "args": ["index"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
]
