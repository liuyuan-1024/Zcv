#!/usr/bin/env bash
#
# 检查变更中新增的平台实现是否位于能力域后端或原生测试边界。
#
# 用法：
#   scripts/check-platform-boundaries
#   scripts/check-platform-boundaries --base <提交>
#
# 默认检查工作树相对于 HEAD 的变更。CI 应传入目标分支或事件基准提交，
# 这样检查的是整个变更集，而不是只检查最后一次提交。

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

BASE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --base)
            [[ $# -ge 2 ]] || { echo "--base 需要提交或引用" >&2; exit 2; }
            BASE="$2"
            shift 2
            ;;
        -h|--help)
            sed -n '2,10p' "$0"
            exit 0
            ;;
        *)
            echo "未知参数：$1" >&2
            exit 2
            ;;
    esac
done

if [[ -n "$BASE" ]]; then
    git cat-file -e "$BASE^{commit}" 2>/dev/null || {
        echo "找不到边界检查基准提交：$BASE" >&2
        exit 2
    }
    DIFF_ARGS=("$BASE")
else
    DIFF_ARGS=(HEAD)
fi

# 这些词代表系统 API 或平台资源。普通 Git 命令本身不是平台差异，
# 因此不在这里禁止 Command::new。
PATTERN='#[[:space:]]*cfg|cfg![[:space:]]*\(|target_os|target_family|taskkill|killpg|CreateFileW|MoveFileExW|std::os::(windows|unix)|windows_sys::|libc::|Contents/MacOS'

is_backend_path() {
    case "$1" in
        */platform.rs|*/platform/*|*/test/*|zcv-terminal/src/alacritty.rs|zcv-update/src/bin/zcv-update-helper.rs)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

violations=()
current_path=""
while IFS= read -r line; do
    if [[ "$line" == +++\ b/* ]]; then
        current_path="${line#+++ b/}"
        continue
    fi
    [[ "$line" == +* ]] || continue
    [[ -n "$current_path" ]] || continue
    added="${line:1}"

    # 应用入口保留 windows_subsystem 是进程级构建属性，不是业务平台流程。
    if [[ "$current_path" == "zcv/src/main.rs" && "$added" == *"windows_subsystem"* ]]; then
        continue
    fi
    is_backend_path "$current_path" && continue

    if rg -q "$PATTERN" <<<"$added"; then
        violations+=("$current_path: $added")
    fi
done < <(git diff --no-ext-diff --unified=0 "${DIFF_ARGS[@]}" -- '*.rs')

if ((${#violations[@]} > 0)); then
    echo "发现新增的平台实现离开能力域后端边界：" >&2
    printf '  %s\n' "${violations[@]}" >&2
    echo "请将系统差异移动到对应 platform 模块，或在评审中明确说明原生测试边界。" >&2
    exit 1
fi

echo "跨平台能力边界检查通过。"
