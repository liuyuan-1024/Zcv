[
  {
    "context": "Editor",
    "bindings": {
      "cmd-c": "editor::Copy",
      "cmd-shift-z": "editor::Redo",
      "cmd-v": "editor::Paste",
      "cmd-x": "editor::Cut",
      "cmd-z": "editor::Undo"
    }
  },
  {
    "context": "ProjectTree",
    "bindings": {
      "down": "project_tree::TreeSelectNext",
      "left": "project_tree::TreeCollapse",
      "right": "project_tree::TreeExpand",
      "space": "project_tree::TreeActivate",
      "up": "project_tree::TreeSelectPrev"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-h": "pane::PrevTab",
      "cmd-l": "pane::NextTab",
      "cmd-w": "pane::CloseTab"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "up": "picker::PickerSelectPrev",
      "down": "picker::PickerSelectNext",
      "enter": "picker::PickerConfirm",
      "escape": "picker::PickerCancel",
      "cmd-o": "project_picker::OpenLocalProject"
    }
  },
  {
    "bindings": {
      "cmd-m": "window_controls::MinimizeWindow",
      "cmd-q": "window_controls::QuitWindow",
      "ctrl-cmd-f": "window_controls::ToggleMaximizeWindow"
    }
  },
  {
    "bindings": {
      "cmd-,": "top_bar::OpenSettings",
      "cmd-shift-b": "top_bar::ToggleBranchPicker",
      "cmd-shift-enter": "top_bar::GitPush",
      "cmd-shift-p": "project_picker::TogglePicker",
      "cmd-shift-pull": "top_bar::GitPull"
    }
  },
  {
    "bindings": {
      "cmd-j": "bottom_bar::ToggleTerminal",
      "cmd-shift-d": "bottom_bar::ToggleDebug",
      "cmd-shift-e": "bottom_bar::ToggleProjectTree",
      "cmd-shift-f": "bottom_bar::ToggleProjectSearch",
      "cmd-shift-g": "bottom_bar::ToggleVersionControl",
      "cmd-shift-k": "bottom_bar::ToggleKeyboardShortcuts",
      "cmd-shift-l": "bottom_bar::ToggleLanguageServer",
      "cmd-shift-m": "bottom_bar::ToggleDiagnostics",
      "cmd-shift-o": "bottom_bar::ToggleOutline"
    }
  }
]
