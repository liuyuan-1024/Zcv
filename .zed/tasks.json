[
  {
      "label": "1. 检查代码",
      "command": "cargo",
      "args": ["clippy"],
      "cwd": "$ZED_WORKTREE_ROOT",
      "save": "all",
      "reveal": "always",
      "hide": "never",
  },
  {
    "label": "2. 格式化代码",
    "command": "cargo",
    "args": ["fmt"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "3. 全量测试",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "4. macOS 调试",
    "command": "cargo",
    "args": ["run", "-p", "Zcv", "--", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "5. macOS 打包",
    "command": "scripts/bundle-mac",
    "args": [],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "6. 全部性能基准",
    "command": "cargo",
    "args": [
      "bench",
      "-p",
      "zcv-benchmarks",
      "--bench",
      "text_buffer",
      "--bench",
      "language_highlighting",
      "--bench",
      "multi_buffer",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "CRITERION_HOME": "$ZED_WORKTREE_ROOT/.performance/criterion",
    },
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "7. 记录当前版本性能基准",
    "command": "cargo bench -p zcv-benchmarks --bench text_buffer --bench language_highlighting --bench multi_buffer -- --save-baseline \"$(git rev-parse --short HEAD)\"",
    "args": [],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "CRITERION_HOME": "$ZED_WORKTREE_ROOT/.performance/criterion",
    },
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
]
