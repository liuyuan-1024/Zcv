[
  {
    "label": "启动软件",
    "command": "cargo",
    "args": ["run", "--bin", "zom"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "16MB Rust 文件性能测试",
    "command": "cargo",
    "args": ["run", "--release", "-p", "zom-bench", "--", "run", "rust", "16"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "打包 macos .app（仅mac M芯片系列可用）",
    "command": "script/bundle-mac",
    "args": ["--no-dmg"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "打包 windows exe（仅windows可用）",
    "command": "powershell",
    "args": [
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "script/bundle-windows.ps1",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
]
