[
  {
    "label": "格式化代码",
    "command": "cargo",
    "args": ["fmt"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "全量测试",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "启动软件",
    "command": "cargo",
    "args": ["run", "--bin", "zom"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "跨规模（1/4/16/64 MiB）Rust 文件性能测试",
    "command": "cargo",
    "args": ["run", "--release", "-p", "zom-bench", "--", "run", "rust"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "16MB Rust 文件性能测试",
    "command": "cargo",
    "args": ["run", "--release", "-p", "zom-bench", "--", "run", "rust", "16"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "打包 macOS .app",
    "command": "script/bundle-mac",
    "args": ["--no-dmg"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "打包 Windows exe",
    "command": "powershell",
    "args": [
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "script/bundle-windows.ps1",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "hide": "never",
  },
]
